DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nachtveilig"
AUTH_SECRET="change_me_to_a_long_random_secret"
APP_NAME="NachtVeilig"
APP_URL="http://localhost:3000"
DEFAULT_COUNTRY="NL"
DEFAULT_LANGUAGE="nl"

PUBLIC_LOCATION_RADIUS_METERS=100
MIN_REPORTS_FOR_AREA_STATISTICS=5

LIVE_LOCATION_RETENTION_HOURS=2
PRIVATE_EVIDENCE_RETENTION_DAYS=365
ABUSE_IDENTIFIER_RETENTION_DAYS=30

UPLOAD_MAX_MB=8
RATE_LIMIT_REPORTS_PER_HOUR=5

MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
GEOCODING_PROVIDER="nominatim"
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
